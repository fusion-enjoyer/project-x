<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- İnternet izni bilinçli olarak yok. -->

    <!-- Etkinlikler telefonun takvim deposunda yaşar (DAVx5 gibi uygulamalar da oraya yazar). -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <!-- İsteğe bağlı: rehberdeki doğum günlerini takvimde göstermek için (ayarlardan açılır, varsayılan kapalı). -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Hatırlatıcı bildirimi (Android 13+). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Yeniden başlatınca ertelenmiş hatırlatıcıları kurmak için. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- "Ertele" tam zamanında çalsın: Android 12'de SCHEDULE_EXACT_ALARM, 13+ takvim uygulamalarına USE_EXACT_ALARM. -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <application
        android:name=".TakvimApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Takvim">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Varsayılan takvim uygulaması olarak seçilebilsin. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.APP_CALENDAR" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Saat widget'ları gibi "şu güne git" çağrıları. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data
                    android:host="com.android.calendar"
                    android:pathPrefix="/time"
                    android:scheme="content" />
            </intent-filter>
            <!-- Simgeye uzun basınca: yeni etkinlik, bugün, gündem (Android 7.1+) -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/kisayollar" />
        </activity>

        <activity
            android:name=".DetayActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.item/event" />
            </intent-filter>
        </activity>

        <activity
            android:name=".DuzenleActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Başka uygulamalardan "takvime ekle". -->
            <intent-filter>
                <action android:name="android.intent.action.INSERT" />
                <action android:name="android.intent.action.EDIT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.item/event" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.INSERT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="vnd.android.cursor.dir/event" />
            </intent-filter>
        </activity>

        <!-- .ics dosyası ("Takvim ile aç", paylaş): içe aktarma ekranı -->
        <activity
            android:name=".IcsActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="text/calendar" />
                <data android:mimeType="application/ics" />
                <data android:mimeType="text/x-vcalendar" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/calendar" />
                <data android:mimeType="application/ics" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.dosya"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/dosya_yollari" />
        </provider>

        <activity
            android:name=".AramaActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".AyarlarActivity"
            android:exported="false" />

        <activity
            android:name=".TakvimlerActivity"
            android:exported="false" />

        <receiver
            android:name=".GundemWidget"
            android:exported="true"
            android:label="@string/widget_gundem_adi">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_gundem" />
        </receiver>

        <receiver
            android:name=".AyWidget"
            android:exported="true"
            android:label="@string/widget_ay_adi">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_ay" />
        </receiver>

        <receiver
            android:name=".SiradakiWidget"
            android:exported="true"
            android:label="@string/widget_siradaki_adi">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_siradaki" />
        </receiver>

        <!-- Widget'ları yeniler: depo değişti, saat/dilim değişti, gece yarısı alarmı, açılış. -->
        <receiver
            android:name=".WidgetYenileAlici"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PROVIDER_CHANGED" />
                <data
                    android:host="com.android.calendar"
                    android:scheme="content" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.ekosistem.takvim.WIDGET_GUNCELLE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Günlük özet bildirimi (isteğe bağlı): alarm + açılış/saat değişimi -->
        <receiver
            android:name=".OzetAlici"
            android:exported="true">
            <intent-filter>
                <action android:name="com.ekosistem.takvim.GUNLUK_OZET" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Bildirim panelinde "Yeni etkinlik" döşemesi (Android 7+) -->
        <service
            android:name=".YeniEtkinlikDosemesi"
            android:exported="true"
            android:icon="@drawable/ic_bildirim"
            android:label="@string/dosemesi_yeni"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <receiver
            android:name=".HatirlaticiAlici"
            android:exported="true">
            <!-- Takvim deposu vakti gelen hatırlatıcıları bununla duyurur. Yayında MIME türü yok
                 (emülatörde görüldü), yalnız content://com.android.calendar/<an> adresi var. -->
            <intent-filter>
                <action android:name="android.intent.action.EVENT_REMINDER" />
                <data
                    android:host="com.android.calendar"
                    android:scheme="content" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
