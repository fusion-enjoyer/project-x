<?xml version="1.0" encoding="utf-8"?>
<!-- Gündem widget'ı: başlık + yeni etkinlik, en çok 6 etkinlik satırı (boyuta göre koddan gizlenir). Üretilmiştir. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetKok"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widgetBaslik"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:text="@string/gorunum_gundem"
            android:textColor="@color/metin"
            android:textSize="17sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/widgetYeni"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@null"
            android:contentDescription="@string/yeni_etkinlik"
            android:padding="9dp"
            android:src="@drawable/ic_arti_vurgu" />
    </LinearLayout>

    <TextView
        android:id="@+id/widgetBos"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="12dp"
        android:textColor="@color/metin_ikincil"
        android:textSize="14sp"
        android:visibility="gone" />

        <LinearLayout
            android:id="@+id/gr0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:minHeight="44dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:id="@+id/gs0"
                android:layout_width="52dp"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/metin"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/gb0"
                android:importantForAccessibility="no"
                android:layout_width="4dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_cubuk" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/gad0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/metin"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/gsaat0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/metin_ikincil"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
