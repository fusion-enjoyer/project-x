<?xml version="1.0" encoding="utf-8"?>
<!-- Dünya saati sekmesi: yerel saat ve şehirler aynı kart satırlarında.
     Saatler TextClock: kendi kendine güncellenir, uygulama kod çalıştırmaz. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sekmeDunya"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingLeft="20dp"
    android:paddingTop="8dp"
    android:paddingRight="20dp"
    android:paddingBottom="104dp"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/dunyaListesi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
