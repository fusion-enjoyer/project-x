<?xml version="1.0" encoding="utf-8"?>
<!-- Dünya saati sekmesi: üstte yerel saat, altında şehir kartları.
     Saatler TextClock: kendi kendine güncellenir, uygulama kod çalıştırmaz. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sekmeDunya"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingLeft="20dp"
    android:paddingTop="8dp"
    android:paddingRight="20dp"
    android:paddingBottom="104dp"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextClock
            android:id="@+id/dunyaYerelSaat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:gravity="center"
            android:includeFontPadding="false"
            android:textColor="@color/metin"
            android:textSize="64sp" />

        <TextClock
            android:id="@+id/dunyaYerelTarih"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:format12Hour="EEEE, d MMMM"
            android:format24Hour="EEEE, d MMMM"
            android:gravity="center"
            android:textColor="@color/metin_ikincil"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/dunyaListesi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
