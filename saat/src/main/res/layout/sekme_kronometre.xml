<?xml version="1.0" encoding="utf-8"?>
<!-- Kronometre sekmesi: büyük süre, iki yuvarlak düğme, turlar. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sekmeKronometre"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="20dp"
    android:paddingRight="20dp"
    android:visibility="gone">

    <Space
        android:id="@+id/kronoUst"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/kronoSure"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:fontFeatureSettings="tnum"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="00:00.00"
        android:textColor="@color/metin"
        android:textSize="64sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/kronoSol"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:background="@drawable/bg_daire"
            android:backgroundTint="@color/kart"
            android:gravity="center"
            android:textColor="@color/metin"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/kronoSag"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_marginLeft="48dp"
            android:background="@drawable/bg_daire"
            android:gravity="center"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <Space
        android:id="@+id/kronoAlt"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.35" />

    <ScrollView
        android:id="@+id/kronoTurKaydirici"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="24dp"
        android:layout_weight="1"
        android:visibility="gone"
        android:clipToPadding="false"
        android:paddingBottom="104dp">

        <LinearLayout
            android:id="@+id/kronoTurlar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
