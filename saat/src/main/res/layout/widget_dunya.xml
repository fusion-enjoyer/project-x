<?xml version="1.0" encoding="utf-8"?>
<!-- Dünya saatleri (4x2): ilk dört şehir 2x2 ızgarada; şehir yoksa ekleme çağrısı. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetKok"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="10dp">

    <TextView
        android:id="@+id/widgetDunyaBos"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/bos_sehir_aciklama"
        android:textColor="@color/metin_ikincil"
        android:textSize="14sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widgetDunyaSatir1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/widgetDunya1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="6dp">

            <TextView
                android:id="@+id/widgetDunyaAd1"
                android:text="London"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/metin_ikincil"
                android:textSize="12sp" />

            <TextClock
                android:id="@+id/widgetDunyaSaat1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textColor="@color/metin"
                android:textSize="22sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widgetDunya2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="6dp">

            <TextView
                android:id="@+id/widgetDunyaAd2"
                android:text="Tokyo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/metin_ikincil"
                android:textSize="12sp" />

            <TextClock
                android:id="@+id/widgetDunyaSaat2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textColor="@color/metin"
                android:textSize="22sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widgetDunyaSatir2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/widgetDunya3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="6dp">

            <TextView
                android:id="@+id/widgetDunyaAd3"
                android:text="New York"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/metin_ikincil"
                android:textSize="12sp" />

            <TextClock
                android:id="@+id/widgetDunyaSaat3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textColor="@color/metin"
                android:textSize="22sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widgetDunya4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="6dp">

            <TextView
                android:id="@+id/widgetDunyaAd4"
                android:text="Paris"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/metin_ikincil"
                android:textSize="12sp" />

            <TextClock
                android:id="@+id/widgetDunyaSaat4"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textColor="@color/metin"
                android:textSize="22sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
