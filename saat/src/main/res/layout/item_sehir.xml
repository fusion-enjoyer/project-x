<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_kart"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="18dp"
    android:paddingTop="16dp"
    android:paddingRight="18dp"
    android:paddingBottom="16dp">

    <!-- Sürükleyerek sıralama tutacı (yalnız eklenen şehirlerde görünür). -->
    <ImageView
        android:id="@+id/sehirTutac"
        android:layout_width="40dp"
        android:layout_height="48dp"
        android:layout_marginLeft="-10dp"
        android:contentDescription="@string/siralama_tutaci"
        android:paddingLeft="8dp"
        android:paddingRight="12dp"
        android:src="@drawable/ic_tutac"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/sehirAd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/metin"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sehirFark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/metin_ikincil"
            android:textSize="13sp" />
    </LinearLayout>

    <TextClock
        android:id="@+id/sehirSaat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="12dp"
        android:fontFeatureSettings="tnum"
        android:includeFontPadding="false"
        android:textColor="@color/metin"
        android:textSize="36sp" />
</LinearLayout>
