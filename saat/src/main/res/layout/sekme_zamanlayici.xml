<?xml version="1.0" encoding="utf-8"?>
<!-- Zamanlayıcı sekmesi: rakamla süre girişi ya da çalışan zamanlayıcılar. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sekmeZamanlayici"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:visibility="gone">

    <LinearLayout
        android:id="@+id/zamanGiris"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingBottom="96dp">

        <TextView
            android:id="@+id/zamanGosterge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:fontFeatureSettings="tnum"
            android:gravity="center"
            android:textColor="@color/metin"
            android:textSize="52sp" />

        <!-- Hazır ayarlar: dokununca hemen başlar, uzun basınca düzenle/sil. -->
        <HorizontalScrollView
            android:id="@+id/zamanHazirKaydirici"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:clipToPadding="false"
            android:paddingLeft="20dp"
            android:paddingRight="20dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/zamanHazirlar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tus1"
                android:layout_width="72dp"
                android:layout_height="60dp"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:text="1"
                android:fontFamily="sans-serif-light"
                android:textColor="@color/metin"
                android:textSize="32sp" />

            <TextView
                android:id="@+id/tus2"
                android:layout_width="72dp"
                android:layout_height="60dp"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:text="2"
                android:fontFamily="sans-serif-light"
                android:textColor="@color/metin"
                android:textSize="32sp" />

            <TextView
                android:id="@+id/tus3"
                android:layout_width="72dp"
                android:layout_height="60dp"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:text="3"
                android:fontFamily="sans-serif-light"
                android:textColor="@color/metin"
                android:textSize="32sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tus4"
                android:layout_width="72dp"
                android:layout_height="60dp"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:text="4"
                android:fontFamily="sans-serif-light"
                android:textColor="@color/metin"
                android:textSize="32sp" />

            <TextView
                android:id="@+id/tus5"
                android:layout_width="72dp"
                android:layout_height="60dp"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:text="5"
                android:fontFamily="sans-serif-light"
                android:textColor="@color/metin"
                android:textSize="32sp" />

            <TextView
                android:id="@+id/tus6"
                android:layout_width="72dp"
                android:layout_height="60dp"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:text="6"
                android:fontFamily="sans-serif-light"
                android:textColor="@color/metin"
                android:textSize="32sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tus7"
                android:layout_width="72dp"
                android:layout_height="60dp"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:text="7"
                android:fontFamily="sans-serif-light"
                android:textColor="@color/metin"
                android:textSize="32sp" />

            <TextView
                android:id="@+id/tus8"
                android:layout_width="72dp"
                android:layout_height="60dp"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:text="8"
                android:fontFamily="sans-serif-light"
                android:textColor="@color/metin"
                android:textSize="32sp" />

            <TextView
                android:id="@+id/tus9"
                android:layout_width="72dp"
                android:layout_height="60dp"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:text="9"
                android:fontFamily="sans-serif-light"
                android:textColor="@color/metin"
                android:textSize="32sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tus00"
                android:layout_width="72dp"
                android:layout_height="60dp"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:text="00"
                android:fontFamily="sans-serif-light"
                android:textColor="@color/metin"
                android:textSize="32sp" />

            <TextView
                android:id="@+id/tus0"
                android:layout_width="72dp"
                android:layout_height="60dp"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:text="0"
                android:fontFamily="sans-serif-light"
                android:textColor="@color/metin"
                android:textSize="32sp" />

            <TextView
                android:id="@+id/tusSil"
                android:layout_width="72dp"
                android:layout_height="60dp"
                android:layout_marginLeft="12dp"
                android:layout_marginRight="12dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:gravity="center"
                android:text="⌫"
                android:fontFamily="sans-serif-light"
                android:textColor="@color/metin"
                android:textSize="32sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/zamanBaslat"
            android:layout_width="200dp"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_pill_buton"
            android:gravity="center"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/zamanKaydirici"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingLeft="20dp"
        android:paddingTop="16dp"
        android:paddingRight="20dp"
        android:paddingBottom="104dp">

        <LinearLayout
            android:id="@+id/zamanListesi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</FrameLayout>
