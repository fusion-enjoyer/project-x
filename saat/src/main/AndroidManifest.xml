<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- İnternet izni bilinçli olarak yok. -->

    <!-- Tam dakikasında çalan alarm: Android 12'de SCHEDULE_EXACT_ALARM,
         13+ yalnız alarm uygulamalarına verilen USE_EXACT_ALARM. -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- Açılışta alarmları yeniden kurmak için. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Alarm ekranı kilit ekranında tam ekran bildirimle açılır. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Alarm çalarken sesi ayakta tutan ön plan hizmeti. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".SaatApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Saat">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".DuzenleActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".AyarlarActivity"
            android:exported="false" />

        <!-- Alarm ekranı: kilit açılmadan da açılır, son uygulamalarda kalmaz,
             uygulamanın kendi görev yığınına karışmaz. -->
        <activity
            android:name=".CalmaActivity"
            android:directBootAware="true"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:showOnLockScreen="true"
            android:taskAffinity="com.ekosistem.saat.calma"
            android:theme="@style/Theme.Saat.Calma" />

        <service
            android:name=".CalmaHizmeti"
            android:directBootAware="true"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <activity
            android:name=".ZamanDolduActivity"
            android:directBootAware="true"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:showOnLockScreen="true"
            android:taskAffinity="com.ekosistem.saat.zaman"
            android:theme="@style/Theme.Saat.Calma" />

        <service
            android:name=".ZamanlayiciHizmeti"
            android:directBootAware="true"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <activity
            android:name=".SehirSecActivity"
            android:exported="false"
            android:windowSoftInputMode="stateVisible|adjustResize" />

        <receiver
            android:name=".SaatWidget"
            android:exported="false"
            android:label="@string/widget_adi">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_saat" />
        </receiver>

        <receiver
            android:name=".AlarmAlici"
            android:directBootAware="true"
            android:exported="false" />

        <!-- Açılış (kilit açılmadan da), saat/saat dilimi değişimi, güncelleme,
             izin değişimi: hepsinde alarmlar baştan kurulur. -->
        <receiver
            android:name=".SistemAlici"
            android:directBootAware="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
