<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- İnternet izni bilinçli olarak yok. -->

    <!-- Android 5.0–12: fotoğraf ve videoları okumak için. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Android 5.0–9: döndürülmüş/kırpılmış kopyayı Resimler klasörüne yazmak için.
         Android 10 ve sonrasında kendi eklediğimiz dosya için izin gerekmez. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />
    <!-- Android 13+: fotoğraf ve video ayrı izinler. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />
    <!-- Android 14+: kullanıcı "yalnız seçtiklerim" derse de çalışalım. -->
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />

    <application
        android:name=".GaleriApp"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.Galeri">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Varsayılan galeri uygulaması olarak seçilebilsin. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.APP_GALLERY" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".AlbumActivity"
            android:exported="false" />

        <activity
            android:name=".AramaActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Tam ekran görüntüleyici; başka uygulamalardan "Galeri ile aç" da buraya gelir. -->
        <activity
            android:name=".IzleyiciActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="true"
            android:theme="@style/Theme.Galeri.Izleyici">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <activity
            android:name=".KirpActivity"
            android:exported="false"
            android:theme="@style/Theme.Galeri.Izleyici" />
    </application>
</manifest>
