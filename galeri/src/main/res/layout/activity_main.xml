<?xml version="1.0" encoding="utf-8"?>
<!-- Kökte fitsSystemWindows varsa ona yatay padding verilmez (Notlar'dan ders);
     kenar payı alt kapsayıcıda. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/zemin"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="20dp"
            android:paddingTop="24dp"
            android:paddingRight="12dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/baslik"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/metin"
                android:textSize="32sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnAra"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_daire"
                android:backgroundTint="@color/kart"
                android:contentDescription="@string/ara"
                android:src="@drawable/ic_ara"
                app:tint="@color/metin" />
        </LinearLayout>

        <!-- Android 14+: kullanıcı yalnız bazı fotoğraflara izin verdiyse -->
        <TextView
            android:id="@+id/kismiUyari"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="4dp"
            android:layout_marginRight="20dp"
            android:layout_marginBottom="4dp"
            android:background="@drawable/bg_kapak"
            android:minHeight="48dp"
            android:padding="14dp"
            android:text="@string/kismi_erisim"
            android:textColor="@color/metin"
            android:textSize="14sp"
            android:visibility="gone" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/liste"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="88dp"
                android:scrollbars="vertical" />

            <ProgressBar
                android:id="@+id/yukleniyor"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:layout_marginBottom="64dp"
                android:visibility="gone" />

            <include
                android:id="@+id/bosDurum"
                layout="@layout/bos_durum"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginBottom="64dp" />

            <View
                android:id="@+id/altSis"
                android:layout_width="match_parent"
                android:layout_height="88dp"
                android:layout_gravity="bottom"
                android:background="@drawable/bg_alt_sis"
                android:importantForAccessibility="no" />

            <!-- Yüzen alt kapsül: içeriği kadar geniş, ortada; ailenin sekme hapı dili. -->
            <LinearLayout
                android:id="@+id/sekmeler"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_arac_cubugu"
                android:elevation="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="4dp"
                android:paddingRight="4dp" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
