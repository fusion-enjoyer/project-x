<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:padding="6dp">

    <com.ekosistem.galeri.KareCerceve
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_kapak">

        <ImageView
            android:id="@+id/albumKapak"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />
    </com.ekosistem.galeri.KareCerceve>

    <TextView
        android:id="@+id/albumAd"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingLeft="2dp"
        android:textColor="@color/metin"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/albumAdet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="2dp"
        android:textColor="@color/metin_ikincil"
        android:textSize="13sp" />
</LinearLayout>
