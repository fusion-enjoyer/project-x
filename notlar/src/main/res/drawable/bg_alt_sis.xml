<?xml version="1.0" encoding="utf-8"?>
<!-- Yüzen çubuğun arkası: altta düz zemin, üstte 40 dp'lik yumuşak geçiş. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="40dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/zemin" />
        </shape>
    </item>
    <item android:bottom="64dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:endColor="@color/zemin_saydam"
                android:startColor="@color/zemin" />
        </shape>
    </item>
</layer-list>
