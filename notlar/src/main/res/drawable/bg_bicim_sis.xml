<?xml version="1.0" encoding="utf-8"?>
<!-- Biçim çubuğunun arkası: üstte 20 dp'lik yumuşak geçiş, altta sayfa zemini. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:top="20dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/zemin" />
        </shape>
    </item>
    <!-- Kap 72 dp: 20 dp geçiş + 52 dp çubuk (gravity/height API 23 ister). -->
    <item android:bottom="52dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:endColor="@color/zemin_saydam"
                android:startColor="@color/zemin" />
        </shape>
    </item>
</layer-list>
