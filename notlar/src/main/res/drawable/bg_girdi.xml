<?xml version="1.0" encoding="utf-8"?>
<!--
  Alt sayfadaki metin kutusu. Sayfa kart renginde olduğu için arama kutusunun
  zemini (o da kart rengi) burada görünmüyordu; kutu sayfa zemininde ve ince
  çerçeveli durur, yazılacak yer belli olsun.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/zemin" />
    <corners android:radius="24dp" />
    <stroke android:width="1dp" android:color="@color/ayrac" />
</shape>
