<?xml version="1.0" encoding="utf-8"?>
<!--
  Kenar payı (20dp) kökte değil, çocuklarda durur: fitsSystemWindows kökün
  padding'ini sistem çentikleriyle baştan yazar ve yatayda 0'a düşürürdü.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingRight="20dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp">

            <!-- Sağ üstteki eylemler yüzen gezinme çubuğuna taşındı. -->
            <LinearLayout
                android:id="@+id/baslikCubugu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/baslik"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/app_name"
                    android:textColor="@color/metin"
                    android:textSize="30sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/secimCubugu"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageButton
                    android:id="@+id/secimKapat"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/kapat"
                    android:src="@drawable/ic_kapat" />

                <TextView
                    android:id="@+id/secimSayi"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:textColor="@color/metin"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/secimSabitle"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/sabitle"
                    android:src="@drawable/ic_sabit_24" />

                <ImageButton
                    android:id="@+id/secimTasi"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/klasore_tasi"
                    android:src="@drawable/ic_tasi" />

                <ImageButton
                    android:id="@+id/secimPaylas"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/paylas"
                    android:src="@drawable/ic_paylas" />

                <ImageButton
                    android:id="@+id/secimSil"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/sil"
                    android:src="@drawable/ic_sil" />

                <ImageButton
                    android:id="@+id/secimDiger"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/diger"
                    android:src="@drawable/ic_menu" />
            </LinearLayout>
        </FrameLayout>

        <!-- Arama kutusunun sağında: arama sürerken "Aranıyor…", bitince "temizle". -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp">

            <EditText
                android:id="@+id/arama"
                android:importantForAutofill="no"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_arama_pill"
                android:drawableStart="@drawable/ic_ara"
                android:drawablePadding="10dp"
                android:hint="@string/ara"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:paddingLeft="16dp"
                android:paddingRight="48dp"
                android:textColor="@color/metin"
                android:textColorHint="@color/metin_ikincil"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/aramaGostergesi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="18dp"
                android:text="@string/araniyor"
                android:textColor="@color/metin_ikincil"
                android:textSize="13sp"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/aramaTemizle"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end|center_vertical"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/aramayi_temizle"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_kapat"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- Çipler kenardan başlar ama kaydırırken kenarın altına kayar. -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:clipToPadding="false"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/klasorSatiri"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingLeft="20dp"
        android:paddingRight="20dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/liste"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="16dp"
            android:paddingBottom="88dp" />

        <!-- Yüzen çubuğun kapladığı yer kadar yukarıda ortalanır. -->
        <include
            android:id="@+id/bosDurum"
            layout="@layout/bos_durum"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="64dp" />

        <!--
          Yüzen çubuğun arkasında zeminden saydama geçiş: altından kayan kart
          metni çubuğun yanlarında ve altında yarım görünmesin. Dokunmayı almaz.
          Çerçevenin yan boşluklarını da kaplasın diye negatif kenar payı var.
        -->
        <View
            android:id="@+id/altSis"
            android:layout_width="match_parent"
            android:layout_height="104dp"
            android:layout_gravity="bottom"
            android:layout_marginLeft="-20dp"
            android:layout_marginRight="-20dp"
            android:background="@drawable/bg_alt_sis"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:id="@+id/bildirimSeridi"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_gravity="bottom"
            android:layout_marginBottom="88dp"
            android:background="@drawable/bg_serit"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="18dp"
            android:paddingRight="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/bildirimMetin"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/metin"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/bildirimEylem"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:text="@string/geri_al"
                android:textColor="@color/vurgu"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!--
          Yüzen gezinme çubuğu (tasarım dili: "yüzen pill alt bar, 3-5 sekmeli").
          Ortadaki yeni not düğmesi vurgu renginde dairedir, diğerleri düz ikon.
        -->
        <LinearLayout
            android:id="@+id/gezinmeCubugu"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_gravity="bottom"
            android:layout_marginLeft="12dp"
            android:layout_marginRight="12dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_arac_cubugu"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="8dp"
            android:paddingRight="8dp">

            <ImageButton
                android:id="@+id/navGorevler"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/gorevler"
                android:src="@drawable/ic_gorevler" />

            <ImageButton
                android:id="@+id/navGunluk"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/bugunun_notu"
                android:src="@drawable/ic_gunluk" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <ImageButton
                    android:id="@+id/navYeni"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_nav_orta"
                    android:contentDescription="@string/yeni_not"
                    android:src="@drawable/ic_arti" />
            </FrameLayout>

            <ImageButton
                android:id="@+id/navSablon"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/sablonlar"
                android:src="@drawable/ic_sablon" />

            <ImageButton
                android:id="@+id/navMenu"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/menu"
                android:src="@drawable/ic_menu" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
