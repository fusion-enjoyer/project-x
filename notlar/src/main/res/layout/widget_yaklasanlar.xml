<?xml version="1.0" encoding="utf-8"?>
<!-- Yaklaşanlar: hatırlatıcılar ve son tarihli görevler, zaman sırasıyla. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetKok"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/widgetBaslik"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:paddingBottom="6dp"
        android:text="@string/yaklasanlar"
        android:textColor="@color/metin"
        android:textSize="15sp"
        android:textStyle="bold" />

    <ListView
        android:id="@+id/widgetListe"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null" />

    <TextView
        android:id="@+id/widgetBos"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/yaklasan_yok"
        android:textColor="@color/metin_ikincil"
        android:textSize="13sp" />

</LinearLayout>
