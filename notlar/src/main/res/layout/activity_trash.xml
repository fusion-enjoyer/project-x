<?xml version="1.0" encoding="utf-8"?>
<!-- Yatay pay çocuklarda: fitsSystemWindows kökün padding'ini ezer. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:paddingTop="8dp">

        <ImageButton
            android:id="@+id/btnGeri"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/geri"
            android:src="@drawable/ic_geri" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/cop_kutusu"
            android:textColor="@color/metin"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Çöp boşken gizli. -->
        <ImageButton
            android:id="@+id/btnHepsiniSil"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cop_bosalt"
            android:src="@drawable/ic_cop_bosalt"
            android:visibility="gone" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingLeft="20dp"
        android:paddingRight="20dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/liste"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="16dp"
            android:paddingBottom="88dp" />

        <include
            android:id="@+id/bosDurum"
            layout="@layout/bos_durum"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />

        <!-- Kaydırarak kalıcı silmede birkaç saniye "Geri al" şansı (ana ekrandaki şeridin eşi). -->
        <LinearLayout
            android:id="@+id/bildirimSeridi"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_gravity="bottom"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_serit"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="18dp"
            android:paddingRight="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/bildirimMetin"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/metin"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/bildirimEylem"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:text="@string/geri_al"
                android:textColor="@color/vurgu"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>
