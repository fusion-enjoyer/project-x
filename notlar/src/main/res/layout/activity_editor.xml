<?xml version="1.0" encoding="utf-8"?>
<!--
  Obsidian'daki gibi: metin tam ekranı kaplar, üstteki ikonlar ve biçim çubuğu
  onun üzerinde yüzer. Aşağı kaydırınca ikonlar kaçar, yukarı kaydırınca döner.
  İkonların ve çubuğun kendi kutusu yok: sayfanın zemininden saydama inen bir
  geçişin üstünde dururlar, not iki kutunun arasına sıkışmış gibi görünmez.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- Kaydırmayı (ve parmak kalkınca savrulmayı) metin değil bu alan yapar. -->
    <com.ekosistem.notlar.NotKaydirici
        android:id="@+id/kaydirici"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:defaultFocusHighlightEnabled="false"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        android:scrollbars="none"
        tools:targetApi="o">

        <!-- Donanım klavyesiyle gezinirken sistemin gri odak örtüsü metni kaplamasın. -->
        <com.ekosistem.notlar.NotEditText
            android:id="@+id/metinAlani"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@null"
            android:defaultFocusHighlightEnabled="false"
            android:gravity="top"
            android:includeFontPadding="false"
            android:inputType="textMultiLine|textCapSentences"
            android:lineSpacingExtra="4dp"
            android:paddingLeft="20dp"
            android:paddingTop="72dp"
            android:paddingRight="20dp"
            android:paddingBottom="112dp"
            android:textColor="@color/metin"
            android:textColorHint="@color/metin_ikincil"
            android:textCursorDrawable="@drawable/imlec_gizli"
            android:textSize="16sp"
            tools:targetApi="o" />
    </com.ekosistem.notlar.NotKaydirici>

    <!-- Üstte yüzen ikonlar: 80 dp'lik kap, arkası zeminden saydama iner. -->
    <LinearLayout
        android:id="@+id/ustCubuk"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="@drawable/bg_ust_sis"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:paddingLeft="8dp"
        android:paddingTop="8dp"
        android:paddingRight="8dp"
        android:paddingBottom="24dp">

        <ImageButton
            android:id="@+id/btnGeri"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/geri"
            android:src="@drawable/ic_geri" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/btnOkuma"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/okuma_gorunumu"
            android:src="@drawable/ic_okuma" />

        <ImageButton
            android:id="@+id/btnEditorMenu"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/menu"
            android:src="@drawable/ic_menu" />
    </LinearLayout>

    <!-- Bul ve değiştir: açıldığında üstteki ikonların yerini alır -->
    <LinearLayout
        android:id="@+id/bulCubugu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/zemin"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingTop="8dp"
        android:paddingRight="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/bulAlani"
                android:importantForAutofill="no"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_arama_pill"
                android:hint="@string/bul"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:textColor="@color/metin"
                android:textColorHint="@color/metin_ikincil"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/bulSayac"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:minWidth="44dp"
                android:textColor="@color/metin_ikincil"
                android:textSize="12sp" />

            <ImageButton
                android:id="@+id/bulOnceki"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/onceki"
                android:rotation="90"
                android:src="@drawable/ic_geri" />

            <ImageButton
                android:id="@+id/bulSonraki"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/sonraki"
                android:rotation="-90"
                android:src="@drawable/ic_geri" />

            <ImageButton
                android:id="@+id/bulKapat"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/kapat"
                android:src="@drawable/ic_kapat" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/degistirAlani"
                android:importantForAutofill="no"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_arama_pill"
                android:hint="@string/degistir"
                android:inputType="text"
                android:maxLines="1"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:textColor="@color/metin"
                android:textColorHint="@color/metin_ikincil"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnDegistir"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:text="@string/degistir"
                android:textColor="@color/vurgu"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnTumunuDegistir"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:text="@string/tumu_degistir"
                android:textColor="@color/vurgu"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!--
      Altta yüzen biçim çubuğu: kutusu yok, sayfanın zemini üstünde durur.
      Kap 72 dp: üstteki 20 dp, altından kayan yazının yumuşakça kaybolduğu geçiş.
    -->
    <FrameLayout
        android:id="@+id/bicimKaydirici"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bicim_sis"
        android:paddingTop="20dp">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fadingEdgeLength="28dp"
            android:requiresFadingEdge="horizontal"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/bicimCubugu"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="8dp"
                android:paddingRight="8dp" />
        </HorizontalScrollView>
    </FrameLayout>

</FrameLayout>
