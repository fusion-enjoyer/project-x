<?xml version="1.0" encoding="utf-8"?>
<!--
  Obsidian'daki gibi: metin tam ekranı kaplar, üstteki ikonlar ve biçim çubuğu
  onun üzerinde yüzer. Aşağı kaydırınca ikonlar kaçar, yukarı kaydırınca döner.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <com.ekosistem.notlar.NotEditText
        android:id="@+id/metinAlani"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@null"
        android:gravity="top"
        android:inputType="textMultiLine|textCapSentences"
        android:lineSpacingExtra="4dp"
        android:paddingLeft="20dp"
        android:paddingTop="64dp"
        android:paddingRight="20dp"
        android:paddingBottom="96dp"
        android:scrollbars="none"
        android:textColor="@color/metin"
        android:textColorHint="@color/metin_ikincil"
        android:textSize="16sp" />

    <!-- Üstte yüzen ikonlar -->
    <LinearLayout
        android:id="@+id/ustCubuk"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingRight="12dp">

        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_ucan_hap">

            <ImageButton
                android:id="@+id/btnGeri"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/geri"
                android:src="@drawable/ic_geri" />
        </FrameLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:background="@drawable/bg_ucan_hap"
            android:orientation="horizontal"
            android:paddingLeft="4dp"
            android:paddingRight="4dp">

            <ImageButton
                android:id="@+id/btnOkuma"
                android:layout_width="44dp"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/okuma_gorunumu"
                android:src="@drawable/ic_okuma" />

            <ImageButton
                android:id="@+id/btnEditorMenu"
                android:layout_width="44dp"
                android:layout_height="match_parent"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/menu"
                android:src="@drawable/ic_menu" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bul ve değiştir: açıldığında üstteki ikonların yerini alır -->
    <LinearLayout
        android:id="@+id/bulCubugu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/zemin"
        android:orientation="vertical"
        android:paddingLeft="16dp"
        android:paddingRight="8dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/bulAlani"
                android:importantForAutofill="no"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_arama_pill"
                android:hint="@string/bul"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:textColor="@color/metin"
                android:textColorHint="@color/metin_ikincil"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/bulSayac"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:minWidth="44dp"
                android:textColor="@color/metin_ikincil"
                android:textSize="12sp" />

            <ImageButton
                android:id="@+id/bulOnceki"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/onceki"
                android:rotation="90"
                android:src="@drawable/ic_geri" />

            <ImageButton
                android:id="@+id/bulSonraki"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/sonraki"
                android:rotation="-90"
                android:src="@drawable/ic_geri" />

            <ImageButton
                android:id="@+id/bulKapat"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/kapat"
                android:src="@drawable/ic_kapat" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/degistirAlani"
                android:importantForAutofill="no"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="@drawable/bg_arama_pill"
                android:hint="@string/degistir"
                android:inputType="text"
                android:maxLines="1"
                android:paddingLeft="14dp"
                android:paddingRight="14dp"
                android:textColor="@color/metin"
                android:textColorHint="@color/metin_ikincil"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/btnDegistir"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:text="@string/degistir"
                android:textColor="@color/vurgu"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/btnTumunuDegistir"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:text="@string/tumu_degistir"
                android:textColor="@color/vurgu"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Altta yüzen biçim çubuğu -->
    <HorizontalScrollView
        android:id="@+id/bicimKaydirici"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginLeft="12dp"
        android:layout_marginRight="12dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_arac_cubugu"
        android:fadingEdgeLength="28dp"
        android:requiresFadingEdge="horizontal"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/bicimCubugu"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="4dp"
            android:paddingRight="4dp" />
    </HorizontalScrollView>

</FrameLayout>
