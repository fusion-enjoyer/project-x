<?xml version="1.0" encoding="utf-8"?>
<!-- Widget seçicideki örnek görünüm (Android 12+): dört örnek kart. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout style="@style/WidgetOrnekSabitSatir">
        <TextView style="@style/WidgetOrnekSabitKart" android:layout_marginEnd="8dp" android:text="@string/onizleme_sabit_1" />
        <TextView style="@style/WidgetOrnekSabitKart" android:text="@string/onizleme_sabit_2" />
    </LinearLayout>

    <LinearLayout style="@style/WidgetOrnekSabitSatir" android:layout_marginTop="8dp">
        <TextView style="@style/WidgetOrnekSabitKart" android:layout_marginEnd="8dp" android:text="@string/onizleme_sabit_3" />
        <TextView style="@style/WidgetOrnekSabitKart" android:text="@string/onizleme_sabit_4" />
    </LinearLayout>

</LinearLayout>
