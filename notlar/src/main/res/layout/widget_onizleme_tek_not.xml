<?xml version="1.0" encoding="utf-8"?>
<!-- Widget seçicideki örnek görünüm (Android 12+): gerçek içerik yerine örnek not. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_widget"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="@string/onizleme_not_baslik"
        android:textColor="@color/metin"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:lineSpacingExtra="2dp"
        android:text="@string/onizleme_not_govde"
        android:textColor="@color/metin_ikincil"
        android:textSize="12sp" />

</LinearLayout>
