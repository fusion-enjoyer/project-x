<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_kart"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingLeft="12dp"
    android:paddingTop="12dp"
    android:paddingRight="16dp"
    android:paddingBottom="12dp">

    <ImageView
        android:id="@+id/gorevKutu"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:contentDescription="@string/bicim_onay"
        android:padding="1dp"
        android:src="@drawable/ic_kutu_bos" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/gorevMetin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/metin"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/gorevNot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/metin_ikincil"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
