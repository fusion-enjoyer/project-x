<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="BolumBasligi">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:paddingLeft">4dp</item>
        <item name="android:textColor">@color/metin_ikincil</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="AyarAyraci">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0.5dp</item>
        <item name="android:layout_marginLeft">56dp</item>
        <item name="android:background">@color/ayrac</item>
    </style>

    <!-- Widget önizlemelerindeki örnek satırlar (widget_onizleme_*.xml) -->
    <style name="WidgetOrnekBaslik">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/metin</item>
        <item name="android:textSize">14sp</item>
    </style>

    <!-- Hızlı eylemler widget'ındaki düz ikon düğmeleri -->
    <style name="WidgetEylem">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:padding">12dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:tint">@color/metin</item>
    </style>

    <style name="WidgetOrnekGorev">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:maxLines">1</item>
        <item name="android:paddingTop">5dp</item>
        <item name="android:paddingBottom">5dp</item>
        <item name="android:drawableStart">@drawable/ic_kutu_bos</item>
        <item name="android:drawablePadding">10dp</item>
        <item name="android:drawableTint">@color/metin_ikincil</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">@color/metin</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="WidgetOrnekOzet">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/metin_ikincil</item>
        <item name="android:textSize">11sp</item>
    </style>
</resources>
