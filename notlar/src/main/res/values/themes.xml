<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Notlar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/zemin</item>
        <item name="android:statusBarColor">@color/zemin</item>
        <item name="android:navigationBarColor">@color/zemin</item>
        <item name="android:windowLightStatusBar" tools:targetApi="23" xmlns:tools="http://schemas.android.com/tools">true</item>
        <item name="android:textColorPrimary">@color/metin</item>
        <item name="android:textColorSecondary">@color/metin_ikincil</item>
        <item name="colorAccent">@color/vurgu</item>
        <item name="colorControlActivated">@color/vurgu</item>
        <item name="android:textCursorDrawable">@null</item>
    </style>

    <style name="Theme.Notlar.Translucent">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
